__pycache__/
*.pyc

# Local project venv + the secrets file with the actual keys (ANTHROPIC_API_KEY,
# GOOGLE_API_KEY, etc.) -- never committed. .env.example stays in git as the template.
.venv/
.env

# Runtime-generated data -- contains PII (name/address/age) of real reporters
data/

# Derived build artifact (FAISS index + docstore) -- rebuilt automatically from
# training/distress_dataset_final.txt if missing/stale, no need to track it
training/faiss_index/
services/rag_service/training/faiss_index/

# Fine-tuned HeBERT model (~420 MB, mostly model.safetensors) -- downloaded/
# extracted from hebert_distress_model.zip, produced by
# training/train_hebert_colab.ipynb. Not source code, and this size fails a
# normal GitHub push (100 MB per-file limit) -- reproducible by re-running
# training, or download the pre-built weights (see README).
hebert_distress_model/

*.zip
*.log

# Private SSH key for EC2 access -- never committed.
*.pem

# Personal, machine-specific ops scripts for an earlier EC2-tunnel-based
# deployment (SSM/SSH tunnels, Windows Scheduled Tasks). Superseded by the
# local docker-compose setup in the README -- kept locally for reference,
# not relevant to running or reviewing this project.
scripts/
deploy_rag_service_ec2.sh
