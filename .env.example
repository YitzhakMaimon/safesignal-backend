# Copy this file to .env and fill in real values. .env is git-ignored -- .env.example
# is the only one that should ever be committed.

# Used by decision_agent_graph.py (Gemini, via ChatGoogleGenerativeAI) and by
# safesignal.py's /api/v1/vision/textract-rekognition endpoint (Gemini multimodal
# vision, OCR + visual distress-signal detection for the image ingestion path).
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Used by distress_classification.py (AnthropicBedrock) if you run that component
# directly against the Anthropic API instead of through Bedrock/AWS credentials.
ANTHROPIC_API_KEY=

# Used by safesignal.py's /api/v1/audio/transcribe endpoint (Groq-hosted Whisper
# Large v3, synchronous STT for the voice-message ingestion path). If unset, that
# endpoint falls back to its old placeholder/stub transcription text instead of
# failing. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Used only for importing/activating n8n.json into a running n8n instance via its
# REST API (n8n Settings -> API -> Create an API key). Never required at runtime by
# safesignal.py or decision_agent_graph.py themselves.
N8N_API_KEY=
N8N_BASE_URL=http://localhost:5678

# Used by decision_agent_graph.py's output_screening_node (_run_bedrock_guardrails)
# to block PII/credit-card leakage and inappropriate content in the Decision Agent's
# generated output, via boto3's bedrock-runtime apply_guardrail. Requires a Guardrail
# already provisioned in the AWS Bedrock console (or via `aws bedrock create-guardrail`).
# If unset, this check is skipped entirely (not a silent pass -- explicitly flagged
# as "not_implemented" in the screening reason).
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Used by decision_agent_graph.py's log_and_close_node to append every incident
# the Decision Agent closes out (including identifying PII -- names/addresses/
# ages/phone_numbers from Relevant Information Extraction, plus the raw message
# text) as a row in a single cumulative S3 Excel workbook at
# `incidents/incidents_table.xlsx` -- the only place these incidents are
# persisted (no RDS instance, no local Excel fallback; both deliberately
# removed 2026-07-19 in favor of one managed file). If unset, archiving is
# skipped entirely (not a silent pass -- explicitly logged as "not configured").
SAFESIGNAL_S3_BUCKET=

# Used by safesignal.py's telegram_poll_loop() background task to long-poll
# (getUpdates) a Telegram bot for live messages in the group(s) it's been
# added to -- this is what actually feeds the dashboard's live Telegram feed
# (n8n's earlier RapidAPI-based branch for this was retired 2026-07-26: it
# scraped Telegram's public channel-preview page, which doesn't exist for
# regular groups, so it could never see group traffic). Create a bot via
# @BotFather on Telegram, add it to the target group, and disable its
# Privacy Mode (@BotFather -> /setprivacy -> Disable) so it sees all
# messages, not just ones addressed to it. If unset, Telegram polling is
# skipped entirely (logged at startup, not a silent no-op).
TELEGRAM_BOT_TOKEN=

# Used by decision_agent_graph.py's immediate_alert_node (automatic path, fired
# when the Decision Agent classifies an incident as "high" risk) to POST the
# incident to an emergency-alert receiver. Points at the dedicated n8n workflow
# "SafeSignal - Immediate Alert Email (AWS SES)" (Webhook -> AWS SES node, using
# the "AWS (IAM) account 2" credential) so n8n is what actually sends the email
# -- not this backend. Originally built with a Gmail node instead of SES, but
# switched (2026-07-26) for AWS's more generous free-tier sending quota. If
# unset, falls back to this backend's own (currently still-stub)
# /api/v1/immediate-alert endpoint instead.
ALERT_WEBHOOK_URL=http://localhost:5678/webhook/immediate-alert

# Used by safesignal.py's _send_escalation_email (manual path, fired when an
# operator clicks "Escalate to Authorities" in the dashboard) to send via AWS
# SES directly instead of n8n. Both default to the same address -- this is the
# operator's own inbox, not a distribution list.
EMERGENCY_ALERT_EMAIL=yitzhak.maimon1@gmail.com

# Used by safesignal.py's _place_escalation_call -- same trigger as the SES
# email above (operator clicks "Escalate to Authorities"), places a Twilio
# voice call that reads the incident details aloud via text-to-speech.
# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN come from the Twilio Console
# (https://console.twilio.com), TWILIO_FROM_NUMBER is a phone number you've
# purchased/verified in that Twilio account. EMERGENCY_ALERT_PHONE_NUMBER is
# the call destination -- the operator's own phone, in E.164 format
# (e.g. +9725XXXXXXXX), not a real emergency-services number; the operator
# is who decides whether to actually contact authorities. If any of the
# four is unset, calling is skipped entirely (logged, not a silent no-op).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EMERGENCY_ALERT_PHONE_NUMBER=

# AWS region every Bedrock/Comprehend/SES call in this project is pinned to.
BEDROCK_AWS_REGION=us-east-1
