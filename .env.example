# Copy this file to .env and fill in real values. .env is git-ignored -- .env.example
# is the only one that should ever be committed.

# Used by decision_agent_graph.py (Gemini, via ChatGoogleGenerativeAI) and by
# safesignal.py's /api/v1/vision/textract-rekognition endpoint (Gemini multimodal
# vision, OCR + visual distress-signal detection for the image ingestion path).
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Used by distress_classification.py (AnthropicBedrock) if you run that component
# directly against the Anthropic API instead of through Bedrock/AWS credentials.
ANTHROPIC_API_KEY=

# Used by safesignal.py's /api/v1/audio/transcribe endpoint (Groq-hosted Whisper
# Large v3, synchronous STT for the voice-message ingestion path). If unset, that
# endpoint falls back to its old placeholder/stub transcription text instead of
# failing. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Used only for importing/activating n8n.json into a running n8n instance via its
# REST API (n8n Settings -> API -> Create an API key). Never required at runtime by
# safesignal.py or decision_agent_graph.py themselves.
N8N_API_KEY=
N8N_BASE_URL=http://localhost:5678

# Used by decision_agent_graph.py's output_screening_node (_run_bedrock_guardrails)
# to block PII/credit-card leakage and inappropriate content in the Decision Agent's
# generated output, via boto3's bedrock-runtime apply_guardrail. Requires a Guardrail
# already provisioned in the AWS Bedrock console (or via `aws bedrock create-guardrail`).
# If unset, this check is skipped entirely (not a silent pass -- explicitly flagged
# as "not_implemented" in the screening reason).
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Used by decision_agent_graph.py's log_and_close_node to append every incident
# the Decision Agent closes out (including identifying PII -- names/addresses/
# ages/phone_numbers from Relevant Information Extraction, plus the raw message
# text) as a row in a single cumulative S3 Excel workbook at
# `incidents/incidents_table.xlsx` -- the only place these incidents are
# persisted (no RDS instance, no local Excel fallback; both deliberately
# removed 2026-07-19 in favor of one managed file). If unset, archiving is
# skipped entirely (not a silent pass -- explicitly logged as "not configured").
SAFESIGNAL_S3_BUCKET=

# Used by telegram_monitor.py to poll a Telegram channel/group via the
# "Telegram155" provider on RapidAPI (free tier: 2,500 requests/month, hard
# limit). Get a key at https://rapidapi.com/ after subscribing to that API;
# RAPIDAPI_HOST usually doesn't need changing. TELEGRAM_PEER_ID is the
# numeric Peer ID of the channel/group to monitor (not a @username).
RAPIDAPI_KEY=
RAPIDAPI_HOST=telegram155.p.rapidapi.com
TELEGRAM_PEER_ID=1006503122
