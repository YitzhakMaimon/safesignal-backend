# Used by ssh-reverse-tunnel-loop.ps1. Kept as a real SSH config file rather
# than inline -o flags because passing a ProxyCommand containing its own
# quoted argument through PowerShell's native-exe argument marshalling
# mangled the quoting (ssh failed with "hostname contains invalid
# characters") -- a config file sidesteps that entirely.
Host langgraph-ec2
    HostName i-0e10488a3bbbefef9
    User ubuntu
    IdentityFile C:/Users/yitzhama/projects/final_project_safesignal/safesignal-shared-key.pem
    ProxyCommand "C:/Program Files/Amazon/AWSCLIV2/aws.exe" ssm start-session --region us-east-1 --target %h --document-name AWS-StartSSHSession --parameters portNumber=%p
    StrictHostKeyChecking accept-new
    ServerAliveInterval 30
    ServerAliveCountMax 3
